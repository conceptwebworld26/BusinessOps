{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/conceptwebworld26/BusinessOps/lib/schemas/decision_support.schema.json",
  "title": "BusinessOps Decision Support",
  "description": "A draft twelve-part decision package grounded in one genuine strict synthesis set and held beside it (ADR-0032). The parts - decision question, business context, objective, options, criteria, evidence, assumptions, tradeoffs, risks, expected outcomes, guidance, uncertainty - appear under `body` in that order. User framing is stored with its origin and is never evidence; every confidence is derived; recommendations are ADR-0031 class-7 records; at most one option is preferred, and only under ADR-0032's conditions. Every level is closed: there is no score, weight, rank, priority, severity, likelihood or execution status anywhere. Lifecycle is `draft` for everything the engine builds; only the M11 verifier's `finalise()` produces `final`, which adds `verification_record` and changes nothing else (ADR-0034). This schema checks shape; whether each id names a real statement, option or criterion is decided by the decision support engine, which is authoritative. The `recommendation`, `evidence_detail` and `limitation` definitions mirror strategy.schema.json and are pinned to it by test; the only difference is that `issued_by` admits both issuers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis",
    "issued_by",
    "lifecycle",
    "verification",
    "lifecycle_note",
    "subject",
    "as_of",
    "business_model",
    "currency",
    "quality_grade",
    "synthesis_digest",
    "strategy_result_bound",
    "trust_statement",
    "human_decision",
    "order_note",
    "body",
    "material_not_cited",
    "conflicts",
    "limitations",
    "confidence"
  ],
  "oneOf": [
    {"description": "A draft: unverified, carrying no verification record.", "properties": {"lifecycle": {"const": "draft"}, "verification": {"const": "unverified"}}},
    {"description": "A final artifact: verified, with its verification record beside unedited content.", "required": ["verification_record"], "properties": {"lifecycle": {"const": "final"}, "verification": {"const": "verified"}}}
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "analysis": {"const": "decision_support"},
    "issued_by": {"const": "bops-decision-support"},
    "lifecycle": {
      "description": "draft or final. decision_support.build() produces draft only; only verification.finalise() produces final (ADR-0034).",
      "enum": ["draft", "final"]
    },
    "verification": {"enum": ["unverified", "verified"]},
    "lifecycle_note": {"type": "string", "minLength": 1},
    "verification_record": {"$ref": "#/definitions/verification_record"},
    "subject": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "business_model": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "quality_grade": {"type": ["string", "null"]},
    "synthesis_digest": {
      "description": "SHA-256 of the grounding synthesis set's serialisation when the recommendations were built: an identity for the exact evidence, not a copy of it.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strategy_result_bound": {"type": "boolean"},
    "trust_statement": {"type": "string", "minLength": 1},
    "human_decision": {"type": "string", "minLength": 1},
    "order_note": {"type": "string", "minLength": 1},
    "body": {"$ref": "#/definitions/body"},
    "material_not_cited": {"type": "array", "items": {"$ref": "#/definitions/synthesis_id"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"$ref": "#/definitions/limitation"}},
    "confidence": {"$ref": "#/definitions/confidence_assessment"}
  },
  "definitions": {
    "verification_record": {
      "description": "The verification a final artifact carries beside its unedited content (ADR-0034 section 8, ADR-0035 section 7). Present only when lifecycle is final.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "verified_by", "subject_digest", "synthesis_digest", "recomputation_status", "request_id", "record_id"],
      "properties": {
        "verification_id": {"type": "string", "pattern": "^ver-[0-9a-f]{12}$"},
        "verified_by": {"const": "bops-analysis-verifier"},
        "subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "synthesis_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "recomputation_status": {"enum": ["completed", "not_required"]},
        "request_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^rcq-[0-9a-f]{16}$"}]},
        "record_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^rcr-[0-9a-f]{16}$"}]}
      }
    },
    "synthesis_id": {"type": "string", "pattern": "^sy-[0-9a-f]{12}$"},
    "text": {"type": "string", "pattern": "\\S"},
    "level": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "confidence_assessment": {
      "type": "object",
      "required": ["confidence", "reasons"],
      "properties": {
        "confidence": {"$ref": "#/definitions/level"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "option_id": {"type": "string", "pattern": "^opt-[0-9a-f]{12}$"},
    "criterion_id": {"type": "string", "pattern": "^crit-[0-9a-f]{12}$"},
    "recommendation_id": {"type": "string", "pattern": "^rec-[0-9a-f]{12}$"},
    "confidence_reasons": {"type": "array", "items": {"type": "string"}},
    "decision_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin"],
      "properties": {"text": {"$ref": "#/definitions/text"}, "origin": {"const": "user"}}
    },
    "business_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "business_model", "currency", "constraints"],
      "properties": {
        "subject": {"type": ["string", "null"]},
        "business_model": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]},
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "origin"],
            "properties": {"text": {"$ref": "#/definitions/text"}, "origin": {"const": "user"}}
          }
        }
      }
    },
    "objective": {
      "description": "Stated by the user, or recorded as not stated. Never inferred.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "origin", "stated"],
          "properties": {
            "text": {"$ref": "#/definitions/text"},
            "origin": {"const": "user"},
            "stated": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "origin", "stated"],
          "properties": {"text": {"type": "null"}, "origin": {"type": "null"}, "stated": {"const": false}}
        }
      ]
    },
    "option": {
      "description": "A course of action in presentation order. Only a recommendation option names a record; there is no score, weight or rank.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["option_id", "label", "origin", "recommendation_id"],
          "properties": {
            "option_id": {"$ref": "#/definitions/option_id"},
            "label": {"$ref": "#/definitions/text"},
            "origin": {"const": "recommendation"},
            "recommendation_id": {"$ref": "#/definitions/recommendation_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["option_id", "label", "origin", "recommendation_id"],
          "properties": {
            "option_id": {"$ref": "#/definitions/option_id"},
            "label": {"$ref": "#/definitions/text"},
            "origin": {"enum": ["user", "status_quo"]},
            "recommendation_id": {"type": "null"}
          }
        }
      ]
    },
    "criterion": {
      "description": "What the user says matters. A configuration criterion names the resolved materiality key and its layer. There is no weight field.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion_id", "text", "origin", "source"],
          "properties": {
            "criterion_id": {"$ref": "#/definitions/criterion_id"},
            "text": {"$ref": "#/definitions/text"},
            "origin": {"const": "user"},
            "source": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion_id", "text", "origin", "source"],
          "properties": {
            "criterion_id": {"$ref": "#/definitions/criterion_id"},
            "text": {"$ref": "#/definitions/text"},
            "origin": {"const": "configuration"},
            "source": {
              "type": "string",
              "pattern": "^materiality\\.[a-z_]+ \\((default|user|project|command) layer\\)$"
            }
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthesis_id",
        "statement",
        "support",
        "confidence",
        "confidence_reasons",
        "referenced_by"
      ],
      "properties": {
        "synthesis_id": {"$ref": "#/definitions/synthesis_id"},
        "statement": {"type": "string"},
        "support": {"type": "string"},
        "confidence": {"$ref": "#/definitions/level"},
        "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"},
        "referenced_by": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(rec|trd)-[0-9a-f]{12}$"}
        }
      }
    },
    "tradeoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tradeoff_id",
        "option_ids",
        "criterion_ids",
        "text",
        "evidence",
        "assumption_ids",
        "confidence",
        "confidence_reasons"
      ],
      "properties": {
        "tradeoff_id": {"type": "string", "pattern": "^trd-[0-9a-f]{12}$"},
        "option_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/option_id"}},
        "criterion_ids": {"type": "array", "items": {"$ref": "#/definitions/criterion_id"}},
        "text": {"$ref": "#/definitions/text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}},
        "assumption_ids": {"type": "array", "items": {"$ref": "#/definitions/synthesis_id"}},
        "confidence": {"$ref": "#/definitions/level"},
        "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"}
      }
    },
    "risk": {
      "description": "A caution about one option. Evidence is optional; an unevidenced risk is LOW. There is no likelihood, severity or rating.",
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "option_id", "text", "evidence", "confidence", "confidence_reasons"],
      "properties": {
        "risk_id": {"type": "string", "pattern": "^rsk-[0-9a-f]{12}$"},
        "option_id": {"$ref": "#/definitions/option_id"},
        "text": {"$ref": "#/definitions/text"},
        "evidence": {"type": "array", "items": {"$ref": "#/definitions/synthesis_id"}},
        "confidence": {"$ref": "#/definitions/level"},
        "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"}
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "option_id", "text", "evidence", "confidence", "confidence_reasons"],
      "properties": {
        "outcome_id": {"type": "string", "pattern": "^out-[0-9a-f]{12}$"},
        "option_id": {"$ref": "#/definitions/option_id"},
        "text": {"$ref": "#/definitions/text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}},
        "confidence": {"$ref": "#/definitions/level"},
        "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"}
      }
    },
    "guidance": {
      "description": "Class-7 records and at most one preferred option. Either an option is preferred with its basis, or none is and the reason is stated.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recommendations",
            "preferred_option",
            "preference_basis",
            "no_preference_reason",
            "divergences"
          ],
          "properties": {
            "recommendations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/recommendation"}},
            "preferred_option": {"$ref": "#/definitions/option_id"},
            "preference_basis": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recommendation_id", "criterion_ids"],
              "properties": {
                "recommendation_id": {"$ref": "#/definitions/recommendation_id"},
                "criterion_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/definitions/criterion_id"}
                }
              }
            },
            "no_preference_reason": {"type": "null"},
            "divergences": {"type": "array", "items": {"$ref": "#/definitions/divergence"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recommendations",
            "preferred_option",
            "preference_basis",
            "no_preference_reason",
            "divergences"
          ],
          "properties": {
            "recommendations": {"type": "array", "items": {"$ref": "#/definitions/recommendation"}},
            "preferred_option": {"type": "null"},
            "preference_basis": {"type": "null"},
            "no_preference_reason": {"$ref": "#/definitions/text"},
            "divergences": {"type": "array", "items": {"$ref": "#/definitions/divergence"}}
          }
        }
      ]
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_ids", "note"],
      "properties": {
        "recommendation_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/recommendation_id"}},
        "note": {"$ref": "#/definitions/text"}
      }
    },
    "uncertainty": {
      "description": "What is uncertain, missing or contested. A next step is an evidence gap the package carries; it has no owner, date or execution state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "confidence_reasons",
        "options",
        "conflicts",
        "limitations",
        "unresolved_dimensions",
        "next_steps"
      ],
      "properties": {
        "confidence": {"$ref": "#/definitions/level"},
        "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_id", "confidence", "confidence_reasons"],
            "properties": {
              "option_id": {"$ref": "#/definitions/option_id"},
              "confidence": {"$ref": "#/definitions/level"},
              "confidence_reasons": {"$ref": "#/definitions/confidence_reasons"}
            }
          }
        },
        "conflicts": {"type": "array", "items": {"type": "object"}},
        "limitations": {"type": "array", "items": {"$ref": "#/definitions/limitation"}},
        "unresolved_dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["synthesis_id", "dimension", "reason"],
            "properties": {
              "synthesis_id": {"$ref": "#/definitions/synthesis_id"},
              "dimension": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "addresses"],
            "properties": {
              "text": {"$ref": "#/definitions/text"},
              "addresses": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref"],
                "properties": {
                  "kind": {"enum": ["limitation", "conflict", "unresolved_dimension"]},
                  "ref": {"$ref": "#/definitions/text"}
                }
              }
            }
          }
        }
      }
    },
    "body": {
      "description": "The twelve parts of ADR-0032, in order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_question",
        "business_context",
        "objective",
        "options",
        "criteria",
        "evidence",
        "assumptions",
        "tradeoffs",
        "risks",
        "expected_outcomes",
        "guidance",
        "uncertainty"
      ],
      "properties": {
        "decision_question": {"$ref": "#/definitions/decision_question"},
        "business_context": {"$ref": "#/definitions/business_context"},
        "objective": {"$ref": "#/definitions/objective"},
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/option"}},
        "criteria": {"type": "array", "items": {"$ref": "#/definitions/criterion"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence_detail"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/definitions/assumption"}},
        "tradeoffs": {"type": "array", "items": {"$ref": "#/definitions/tradeoff"}},
        "risks": {"type": "array", "items": {"$ref": "#/definitions/risk"}},
        "expected_outcomes": {"type": "array", "items": {"$ref": "#/definitions/expected_outcome"}},
        "guidance": {"$ref": "#/definitions/guidance"},
        "uncertainty": {"$ref": "#/definitions/uncertainty"}
      }
    },
    "request": {
      "description": "What a skill passes to decision_support.build(). Closed: there is no field for confidence, support, trust, verification, lifecycle, weight, score, rank, priority, severity or likelihood. The engine is authoritative.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_question"],
      "properties": {
        "decision_question": {"$ref": "#/definitions/text"},
        "objective": {"$ref": "#/definitions/text"},
        "constraints": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "options": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "include_status_quo": {"type": "boolean"},
        "criteria": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "materiality_criteria": {
          "type": "array",
          "items": {
            "enum": [
              "absolute_amount",
              "percentage",
              "kpi_deviation",
              "revenue_percentage",
              "margin_percentage_points"
            ]
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "evidence", "rationale", "expected_benefit", "risks", "dependencies"],
            "properties": {
              "action": {"$ref": "#/definitions/text"},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}},
              "rationale": {"$ref": "#/definitions/text"},
              "expected_benefit": {"$ref": "#/definitions/text"},
              "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
              "dependencies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text"],
                  "properties": {
                    "text": {"$ref": "#/definitions/text"},
                    "assumption_id": {"type": ["string", "null"], "pattern": "^sy-[0-9a-f]{12}$"}
                  }
                }
              }
            }
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["options", "text", "evidence"],
            "properties": {
              "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
              "criteria": {"type": "array", "items": {"$ref": "#/definitions/text"}},
              "text": {"$ref": "#/definitions/text"},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}},
              "assumptions": {"type": "array", "items": {"$ref": "#/definitions/synthesis_id"}}
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "text"],
            "properties": {
              "option": {"$ref": "#/definitions/text"},
              "text": {"$ref": "#/definitions/text"},
              "evidence": {"type": "array", "items": {"$ref": "#/definitions/synthesis_id"}}
            }
          }
        },
        "expected_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "text", "evidence"],
            "properties": {
              "option": {"$ref": "#/definitions/text"},
              "text": {"$ref": "#/definitions/text"},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}}
            }
          }
        },
        "not_assessable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "reason"],
            "properties": {"option": {"$ref": "#/definitions/text"}, "reason": {"$ref": "#/definitions/text"}}
          }
        },
        "preferred_option": {"$ref": "#/definitions/text"},
        "preference_criteria": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "divergences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recommendations", "note"],
            "properties": {
              "recommendations": {
                "type": "array",
                "minItems": 2,
                "items": {"$ref": "#/definitions/recommendation_id"}
              },
              "note": {"$ref": "#/definitions/text"}
            }
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "addresses"],
            "properties": {
              "text": {"$ref": "#/definitions/text"},
              "addresses": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref"],
                "properties": {
                  "kind": {"enum": ["limitation", "conflict", "unresolved_dimension"]},
                  "ref": {"$ref": "#/definitions/text"}
                }
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "issued_by",
        "provenance_class",
        "label",
        "action",
        "evidence",
        "rationale",
        "expected_benefit",
        "risks",
        "dependencies",
        "confidence",
        "confidence_reasons",
        "support",
        "rests_on",
        "material",
        "evidence_detail",
        "assumptions",
        "conflicts",
        "limitations",
        "caveats"
      ],
      "properties": {
        "recommendation_id": {"type": "string", "pattern": "^rec-[0-9a-f]{12}$"},
        "issued_by": {"enum": ["bops-strategy-recommendations", "bops-decision-support"]},
        "provenance_class": {"const": 7},
        "label": {"const": "RECOMMENDATION"},
        "action": {"$ref": "#/definitions/text"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/synthesis_id"}},
        "rationale": {"$ref": "#/definitions/text"},
        "expected_benefit": {"$ref": "#/definitions/text"},
        "risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "assumption_id"],
            "properties": {
              "text": {"$ref": "#/definitions/text"},
              "assumption_id": {"type": ["string", "null"], "pattern": "^sy-[0-9a-f]{12}$"}
            }
          }
        },
