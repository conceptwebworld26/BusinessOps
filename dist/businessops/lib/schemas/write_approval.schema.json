{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/conceptwebworld26/BusinessOps/lib/schemas/write_approval.schema.json",
  "title": "BusinessOps Write Approval",
  "description": "One record in the write-approval store (ADR-0051), at ~/.claude/businessops/guard/{pending,granted,consumed}/<code>.json. Written by the pre-execution hook or the engine's export API when a consequential write arrives without a capability (pending); moved to granted only by the UserPromptSubmit hook, from the user's own prompt; claimed into consumed by an atomic rename when the identical operation is redeemed. The binding is what the approval authorises: the fingerprint is recomputed from it on every grant and redemption, so this schema checks shape only and the capability module is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "state", "binding", "fingerprint", "created_at", "expires_at"],
  "properties": {
    "schema": {"const": "bops.write-approval/1"},
    "code": {"type": "string", "pattern": "^BOPS-W-[A-Z0-9]{8}$"},
    "state": {"enum": ["pending", "granted", "consumed"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "origin", "tool", "cwd", "input_sha256", "operations"],
      "properties": {
        "session_id": {"type": ["string", "null"], "maxLength": 256},
        "origin": {"enum": ["hook", "engine"]},
        "tool": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "sources", "exists"],
            "properties": {
              "kind": {"enum": ["create", "overwrite", "append", "modify", "truncate", "delete", "move_source", "mkdir", "link", "git_commit", "git_push", "git_mutation", "execute", "unknown_write"]},
              "target": {"type": ["string", "null"]},
              "sources": {"type": "array", "items": {"type": "string"}},
              "exists": {"type": ["boolean", "null"]}
            }
          }
        }
      }
    },
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "integer"},
    "granted_at": {"type": "integer"},
    "consumed_at": {"type": "integer"},
    "expires_at": {"type": "integer"}
  }
}
